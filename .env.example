# PostgreSQL/PostGIS baglanti bilgileri (docker-compose.yml ile uyumlu olmali)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=izmir_bus_eta
DB_USER=eta_user
DB_PASSWORD=change_me_in_local_env

# Izmir Buyuksehir Belediyesi Acik Veri API (IZTEK)
API_BASE_URL=https://openapi.izmir.bel.tr/api/iztek

# Collector ayarlari
COLLECTION_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10

# Not: Bu dosya .env.example'dir, gercek degerleri iceren .env dosyasi
# git'e eklenmemelidir (.gitignore'da olmali). Gercek DB sifresini
# docker-compose.yml'deki POSTGRES_PASSWORD ile ayni tut.
